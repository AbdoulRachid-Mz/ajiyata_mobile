{
  "expo": {
    "name": "Ajiya Ta",
    "slug": "ajiya",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/primary-3.png",
    "scheme": "ajiyata",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static",
      "favicon": "./assets/images/primary-128x131.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7EE",
          "image": "./assets/primary-640.png",
          "imageWidth": 640,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/primary-640.png",
            "imageWidth": 640,
            "backgroundColor": "#FAF7EE"
          },
          "ios": {
            "image": "./assets/primary-640.png",
            "imageWidth": 640,
            "backgroundColor": "#FAF7EE"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autorisez Ajiya Ta à utiliser Face ID pour vous connecter."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_CLIENT_ID"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "ios": {
      "bundleIdentifier": "ajiyata.com",
      "icon": "./assets/images/primary.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Ajiya Ta utilise la caméra pour scanner vos reçus et factures.",
        "NSPhotoLibraryUsageDescription": "Ajiya Ta accède à votre galerie pour importer des reçus."
      },
      "splash": {
        "image": "./assets/primary-640.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAF7EE"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7EE",
        "foregroundImage": "./assets/images/primary.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ajiyata.com",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "splash": {
        "image": "./assets/images/primary.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAF7EE"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "085c8a36-5f57-4cfb-904e-bc990cdd55d0"
      }
    }
  }
}
