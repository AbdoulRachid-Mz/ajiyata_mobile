{
  "expo": {
    "name": "ajiya",
    "slug": "ajiya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/primary-2.png",
    "scheme": "ajiya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/primary.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/primary-2.png",
        "backgroundImage": "./assets/images/primary-2.png",
        "monochromeImage": "./assets/images/primary-2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abdoulrachidmz.ajiya",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/primary.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6F4FE",
          "android": {
            "image": "./assets/primary.png",
            "imageWidth": 864
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autorisez Ajiya Ta à utiliser Face ID pour vous connecter."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_CLIENT_ID"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "icon": "./assets/primary.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Ajiya Ta utilise la caméra pour scanner vos reçus et factures.",
        "NSPhotoLibraryUsageDescription": "Ajiya Ta accède à votre galerie pour importer des reçus."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/primary-2.png",
        "backgroundImage": "./assets/images/primary-2.png",
        "monochromeImage": "./assets/images/primary-2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abdoulrachidmz.ajiya",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "085c8a36-5f57-4cfb-904e-bc990cdd55d0"
      }
    }
  }
}
