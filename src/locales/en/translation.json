  "privacy": {
    "title": "Privacy Policy",
    "last_updated": "Last updated",
    "legal_framework": "Legal Framework & Introduction",
    "intro": "Ajiya Ta (\"we\", \"our\", \"us\") is committed to protecting the privacy of its users. This policy is established in accordance with **Law No. 2017-28 of May 3, 2017** on the protection of personal data in the Republic of Niger and the **ECOWAS Additional Act A/SA.1/01/10**.",
    "consent": "By using Ajiya Ta, you consent to the collection and processing of your information as described below.",
    "data_collected": "Data Collected",
    "identification": "Identification Information",
    "identification_list": "• Full name and username\n• Email address and/or phone number\n• Account preferences and currencies (XOF, USD, etc.)",
    "financial_data": "Financial and Management Data",
    "financial_list": "• Transaction records (income, expenses, transfers)\n• Budgets, savings goals and categories\n• Photos/scans of receipts or invoices (if authorized)",
    "technical_data": "Technical Information",
    "technical_list": "• Device model and Android/iOS system version\n• Unique application installation identifiers",
    "storage_security": "Data Storage and Security",
    "storage_desc": "In accordance with the \"Offline-First\" architecture principle, all your financial records are stored primarily locally on your device.",
    "encryption": "In case of online synchronization, your data is encrypted according to the security standards recommended by cybersecurity regulations.",
    "biometric_note": "Your biometric identifiers (fingerprint, Face ID) are processed exclusively by your phone's secure system and are never transmitted to us.",
    "your_rights": "Your Rights",
    "rights_intro": "In accordance with Nigerien and community regulations, you benefit from the following rights:",
    "rights_list": "• **Right of access:** Obtain confirmation that your data is being processed.\n• **Right of rectification:** Request correction of inaccurate information.\n• **Right of deletion:** Request the permanent deletion of your data.\n• **Right of objection:** Object to the processing of your data for legitimate reasons.",
    "exercise_rights": "Exercise my rights: support@ajiyata.com",
    "regulatory_authority": "Recourse and Regulatory Authority",
    "regulatory_desc": "In the event of a dispute relating to the protection of your personal data not resolved by our support, you have the right to refer the matter to the **High Authority for the Protection of Personal Data (HAPDP)** of the Republic of Niger.",
    "contact_desc": "For any questions regarding this policy:"
  },
  "terms": {
    "title": "Terms of Use",
    "last_updated": "Last updated",
    "object": "1. Purpose and Acceptance",
    "object_text": "These General Terms and Conditions of Use (GTCU) govern access to and use of the **Ajiya Ta** mobile application.",
    "acceptance": "Use of the application implies the user's unreserved acceptance of these GTCU.",
    "service_nature": "2. Nature of the Service",
    "service_desc": "Ajiya Ta is a personal budgeting and financial management tool. The application allows recording financial flows, tracking budgets and managing accounts.",
    "service_warning": "Ajiya Ta is not a credit institution nor an electronic banking payment system. The application constitutes a tool to assist personal accounting monitoring.",
    "user_obligations": "3. User Obligations",
    "obligations_list": "The user undertakes to:\n• Enter accurate data under their sole responsibility.\n• Not use the application for fraudulent or illegal purposes under Nigerien and international laws.\n• Ensure the confidentiality of their unlock access (code, biometrics).",
    "liability": "4. Limitation of Liability",
    "liability_text": "Ajiya Ta provides calculations and statistics for strictly indicative purposes. We cannot be held responsible in the event of data entry errors by the user, loss of data related to the loss or deterioration of the mobile device, or temporary interruption of the service.",
